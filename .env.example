# ==============================================================================
# TruthLens AI — Environment Configuration Example (.env.example)
# Rename this file to .env and fill in your respective API credentials
# ==============================================================================

# ── Groq Cloud LLM (REQUIRED) ───────────────────────────────────────────────
# Get free API keys at https://console.groq.com
# Supports comma-separated keys for automatic round-robin rotation on rate limit (429)
GROQ_API_KEY=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2

# LLM Provider selection: 'groq' or 'mistral' (defaults to mistral if key provided, falling back to groq)
# LLM_PROVIDER=groq

# Mistral is used as the primary reasoning provider when configured.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ── Open-Source Intelligence (OSINT) & News Verification ─────────────────────
# NewsAPI.org — free tier available at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_org_key_here

# NewsData.io — secondary news index at https://newsdata.io/register
NEWSDATA_API_KEY=pub_your_newsdata_io_key_here

# Google Fact Check Tools API — https://console.cloud.google.com
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# ── FFmpeg Executable Directory (REQUIRED for audio extraction) ──────────────
# Provide directory path containing ffmpeg.exe and ffprobe.exe (or leave empty if in system PATH)
# Example (Windows): C:\ffmpeg\bin
# Example (Linux/Mac): /usr/bin/ffmpeg
FFMPEG_PATH=

# ── Redis Cache & Queue (OPTIONAL — In-Memory fallback is active) ────────────
# REDIS_URL=redis://localhost:6379/0

# ── API Keys for Client Authentication (OPTIONAL) ────────────────────────────
# Comma-separated client keys if you want to protect endpoints
# API_KEYS=key1,key2


